# Database (SQLite file, created by `npm run db:push`)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# Stripe (OPTIONAL). When STRIPE_SECRET_KEY is unset, the built-in mock
# payment provider is used and the app is fully functional for demo/dev.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
