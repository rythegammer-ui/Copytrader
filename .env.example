# Database (SQLite file, created by `npm run db:push`)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string"

# Stripe (OPTIONAL). When STRIPE_SECRET_KEY is unset, the built-in mock
# payment provider is used and the app is fully functional for demo/dev.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Production (Vercel + Postgres) ----
# On Vercel, DATABASE_URL must be a Postgres connection string (the Neon
# integration under Vercel → Storage sets DATABASE_URL and DATABASE_URL_UNPOOLED
# for you). The build derives the Postgres schema automatically.
# DATABASE_URL="postgresql://user:pass@host-pooler.region.neon.tech/db?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:pass@host.region.neon.tech/db?sslmode=require"

# Password for the seeded demo accounts. Defaults to "password123" locally —
# ALWAYS set a strong value in production (the demo admin account is real).
# DEMO_PASSWORD="change-me-to-something-long-and-random"
