# @vercel/analytics declares optional peers for Svelte, Vue, Nuxt and Remix.
# npm tries to satisfy them anyway, pulls in @sveltejs/kit, and that wants a
# Vite major this project cannot have alongside vitest. None of those frameworks
# are used here, so peer auto-install is turned off rather than letting an
# unrelated framework dictate our Vite version.
legacy-peer-deps=true
